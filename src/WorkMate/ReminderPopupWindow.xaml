<Window x:Class="WorkMate.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkMate 提醒"
        Width="380"
        Height="168"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}">
  <Border Margin="8" Padding="16"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.16" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="ReminderImage" Width="44" Height="44" Margin="0,2,12,0"
             VerticalAlignment="Top" Stretch="Uniform"
             AutomationProperties.Name="提醒图标" />
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock x:Name="TitleText" Padding="0,0,28,0" FontSize="17"
                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <Button x:Name="CloseButton" Width="26" Height="26" HorizontalAlignment="Right"
                  VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                  FontSize="16" Cursor="Hand" Content="×" ToolTip="关闭"
                  Click="CloseButton_OnClick" AutomationProperties.Name="关闭提醒" />
        </Grid>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,6,0,8"
                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="ActionPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" />
      </Grid>
    </Grid>
  </Border>
</Window>
