<Window x:Class="WorkMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkMate.Controls"
        Title="WorkMate"
        Icon="/WorkMate;component/Assets/Icons/WorkMate.ico"
        Width="{StaticResource DashboardWidth}"
        Height="{StaticResource DashboardHeight}"
        MinWidth="{StaticResource DashboardMinWidth}"
        MinHeight="{StaticResource DashboardMinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
  <Grid Margin="24,4" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border x:Name="StateCard" Grid.Row="0" Height="{StaticResource StateCardHeight}" Padding="20,16"
            Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <Image Width="{StaticResource StateIconSize}"
               Height="{StaticResource StateIconSize}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Source="{Binding StateIcon}"
               Stretch="Uniform"
               AutomationProperties.Name="当前 WorkMate 状态图标" />

        <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="11" Height="11" Margin="0,0,10,0"
                     VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
            <TextBlock FontSize="{StaticResource FontSizeStateTitle}"
                       FontWeight="SemiBold" Text="{Binding StateName}" />
          </StackPanel>
          <TextBlock Margin="21,7,0,0"
                     FontSize="{StaticResource FontSizeStateSubtitle}"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="{Binding StateDescription}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Right" FontSize="32" FontWeight="SemiBold"
                     Text="{Binding CurrentTime}" />
          <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                     FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                     Text="{Binding CurrentDate}" />
          <Border Margin="0,10,0,0" Padding="11,5" HorizontalAlignment="Right"
                  Background="{StaticResource SurfaceSelectedBrush}"
                  CornerRadius="{StaticResource CornerRadiusLarge}">
            <TextBlock Foreground="{StaticResource PrimaryBrush}"
                       FontWeight="SemiBold" Text="{Binding CurrentProfile}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <UniformGrid x:Name="MetricsGrid" Grid.Row="2" Height="{StaticResource MetricsGridHeight}" Rows="2" Columns="3">
      <Border Height="{StaticResource MetricCardHeight}" Margin="0,0,8,4"
              VerticalAlignment="Top" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="{StaticResource MetricIconBoxSize}" Height="{StaticResource MetricIconBoxSize}"
                 VerticalAlignment="Center" Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_today_work.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="今日工作" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding TodayWorkDuration}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="{StaticResource MetricCardHeight}" Margin="4,0,4,4"
              VerticalAlignment="Top" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="{StaticResource MetricIconBoxSize}" Height="{StaticResource MetricIconBoxSize}"
                 VerticalAlignment="Center" Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_continuous_work.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="连续工作" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding ContinuousWorkDuration}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="{StaticResource MetricCardHeight}" Margin="8,0,0,4"
              VerticalAlignment="Top" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="36" Height="36" VerticalAlignment="Center"
                 Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_work_intensity.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="工作强度" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding WorkIntensity}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="{StaticResource MetricCardHeight}" Margin="0,4,8,0"
              VerticalAlignment="Bottom" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="{StaticResource MetricIconBoxSize}" Height="{StaticResource MetricIconBoxSize}"
                 VerticalAlignment="Center" Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_keyboard.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="键盘输入" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding KeyboardCount}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="{StaticResource MetricCardHeight}" Margin="4,4,4,0"
              VerticalAlignment="Bottom" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="{StaticResource MetricIconBoxSize}" Height="{StaticResource MetricIconBoxSize}"
                 VerticalAlignment="Center" Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_mouse.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="鼠标点击" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding MouseClickCount}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Height="{StaticResource MetricCardHeight}" Margin="8,4,0,0"
              VerticalAlignment="Bottom" Style="{StaticResource MetricCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Image Width="{StaticResource MetricIconBoxSize}" Height="{StaticResource MetricIconBoxSize}"
                 VerticalAlignment="Center" Source="/WorkMate;component/Assets/Icons/Generated/Metrics/metric_app_switch.png" />
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource MetricLabelTextStyle}" Text="应用切换" />
            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding AppSwitchCount}" />
          </StackPanel>
        </Grid>
      </Border>
    </UniformGrid>

    <Border x:Name="ActivityChartCard" Grid.Row="4" MinHeight="{StaticResource ChartCardMinHeight}" Padding="20,14"
            Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" FontSize="{StaticResource FontSizeChartTitle}"
                   Text="今日工作强度" />
        <Border HorizontalAlignment="Right" MinWidth="34" Height="34" Padding="8,0"
                Background="{StaticResource PrimaryBrush}" CornerRadius="17">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="White" FontWeight="SemiBold" Text="{Binding WorkIntensity}" />
        </Border>
        <Grid Grid.Row="1" Margin="0,10,0,4">
          <controls:ActivitySparkline ItemsSource="{Binding ActivitySeries}" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="{Binding ActivitySeriesStatus}" />
        </Grid>
        <Grid Grid.Row="2">
          <TextBlock Style="{StaticResource CaptionTextStyle}" Text="今天开始" />
          <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" Text="现在" />
        </Grid>
      </Grid>
    </Border>

    <UniformGrid x:Name="QuickActionsGrid" Grid.Row="6" Height="{StaticResource ActionsGridHeight}" Rows="2" Columns="3">
      <Button Height="{StaticResource ActionButtonHeight}" Margin="0,0,8,4"
              Style="{StaticResource DashboardActionButtonStyle}" Click="DrinkButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_drink.png" />
          <TextBlock VerticalAlignment="Center" Text="喝水 ✓" />
        </StackPanel>
      </Button>
      <Button Height="{StaticResource ActionButtonHeight}" Margin="4,0,4,4"
              Style="{StaticResource DashboardActionButtonStyle}" Click="StandButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_stand.png" />
          <TextBlock VerticalAlignment="Center" Text="站立一下" />
        </StackPanel>
      </Button>
      <Button Height="{StaticResource ActionButtonHeight}" Margin="8,0,0,4"
              Style="{StaticResource DashboardActionButtonStyle}" Click="CleaningButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_cleaning.png" />
          <TextBlock VerticalAlignment="Center" Text="打扫卫生 ✓" />
        </StackPanel>
      </Button>
      <Button Height="{StaticResource ActionButtonHeight}" Margin="0,4,8,0"
              Style="{StaticResource DashboardActionButtonStyle}" Click="LunchButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_lunch.png" />
          <TextBlock VerticalAlignment="Center" Text="开始午休" />
        </StackPanel>
      </Button>
      <Button Height="{StaticResource ActionButtonHeight}" Margin="4,4,4,0"
              Style="{StaticResource DashboardActionButtonStyle}" Click="OvertimeButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_overtime.png" />
          <TextBlock VerticalAlignment="Center" Text="{Binding OvertimeActionText}" />
        </StackPanel>
      </Button>
      <Button Height="{StaticResource ActionButtonHeight}" Margin="8,4,0,0"
              Style="{StaticResource DashboardActionButtonStyle}" Click="HideButton_OnClick">
        <StackPanel Orientation="Horizontal">
          <Image Width="{StaticResource ActionIconBoxSize}" Height="{StaticResource ActionIconBoxSize}"
                 Margin="0,0,9,0" Source="/WorkMate;component/Assets/Icons/Generated/Actions/action_tray.png" />
          <TextBlock VerticalAlignment="Center" Text="隐藏到托盘" />
        </StackPanel>
      </Button>
    </UniformGrid>

    <Grid Grid.Row="8" Height="{StaticResource FooterHeight}">
      <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                 Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
      <Button x:Name="SettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
              Style="{StaticResource SettingsGearButtonStyle}"
              FocusVisualStyle="{x:Null}"
              ToolTip="设置"
              AutomationProperties.Name="打开设置"
              Click="SettingsButton_OnClick">
        <Image Width="{StaticResource SettingsGearIconBoxSize}"
               Height="{StaticResource SettingsGearIconBoxSize}"
               Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_general.png" />
      </Button>
    </Grid>
  </Grid>
</Window>
