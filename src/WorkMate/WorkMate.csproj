<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WorkMate</AssemblyName>
    <RootNamespace>WorkMate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\Assets\Icons\WorkMate.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Assets\Icons\WorkMate.ico">
      <Link>Assets\Icons\WorkMate.ico</Link>
    </Resource>
    <Resource Include="..\..\Assets\Icons\WorkMate_UI_IconPack\**\*.png">
      <Link>Assets\Icons\WorkMate_UI_IconPack\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Resource>
    <Resource Include="..\..\Assets\Icons\Generated\**\*.png">
      <Link>Assets\Icons\Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
</Project>
