<Window x:Class="WorkMate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - WorkMate"
        Icon="/WorkMate;component/Assets/Icons/WorkMate.ico"
        Width="800"
        Height="610"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="176" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource SurfaceMutedBrush}" Padding="14,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Margin="8,0,0,18" Orientation="Horizontal">
            <Image Width="24" Height="24"
                   Source="/WorkMate;component/Assets/Icons/WorkMate_UI_IconPack/App/workmate_default.png"
                   AutomationProperties.Name="WorkMate 设置图标" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16"
                       FontWeight="SemiBold" Text="设置" />
          </StackPanel>
          <RadioButton x:Name="GeneralNavigation" GroupName="SettingsNavigation"
                       Style="{StaticResource NavigationButtonStyle}" IsChecked="True"
                       Checked="Navigation_OnChecked" Tag="General" AutomationProperties.Name="常规">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_general.png" />
              <TextBlock VerticalAlignment="Center" Text="常规" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="Schedule" AutomationProperties.Name="作息时间">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_schedule.png" />
              <TextBlock VerticalAlignment="Center" Text="作息时间" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="Reminders" AutomationProperties.Name="提醒设置">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_reminders.png" />
              <TextBlock VerticalAlignment="Center" Text="提醒设置" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="Speech" AutomationProperties.Name="语音与提示">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_speech.png" />
              <TextBlock VerticalAlignment="Center" Text="语音与提示" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="Appearance" AutomationProperties.Name="图标与界面">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_appearance.png" />
              <TextBlock VerticalAlignment="Center" Text="图标与界面" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="Data" AutomationProperties.Name="数据管理">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_data.png" />
              <TextBlock VerticalAlignment="Center" Text="数据管理" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="SettingsNavigation" Style="{StaticResource NavigationButtonStyle}"
                       Checked="Navigation_OnChecked" Tag="About" AutomationProperties.Name="关于">
            <StackPanel Orientation="Horizontal">
              <Image Width="{StaticResource NavigationIconBoxSize}" Height="{StaticResource NavigationIconBoxSize}" Margin="0,0,10,0"
                     Source="/WorkMate;component/Assets/Icons/Generated/Navigation/nav_about.png" />
              <TextBlock VerticalAlignment="Center" Text="关于" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="8" Style="{StaticResource CaptionTextStyle}"
                   Text="设置窗口关闭后，WorkMate 仍在后台运行。" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="26,22,26,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="常规" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}"
                       Text="启动与窗口行为" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <CheckBox x:Name="AutoStartCheckBox" FontSize="14"
                          Content="开机自动启动" Checked="AutoStartCheckBox_OnChanged"
                          Unchecked="AutoStartCheckBox_OnChanged" />
                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />
                <TextBlock FontWeight="SemiBold" Text="启动后最小化到托盘" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="使用 --startup 启动时已启用" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="单实例运行" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="已启用；重复启动会激活 Dashboard" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="关闭主窗口" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="隐藏到托盘，不退出后台服务" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SchedulePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="作息时间" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}"
                       Text="保存后立即重新加载 ScheduleEngine" />

            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="夏令时" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="上午" />
                  <TextBox x:Name="SummerMorningStartTextBox" Grid.Column="1" MaxLength="5"
                           AutomationProperties.Name="夏令时上午上班时间" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="→" />
                  <TextBox x:Name="SummerMorningEndTextBox" Grid.Column="3" MaxLength="5"
                           AutomationProperties.Name="夏令时上午下班时间" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="下午" />
                  <TextBox x:Name="SummerAfternoonStartTextBox" Grid.Column="1" MaxLength="5"
                           AutomationProperties.Name="夏令时下午上班时间" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="→" />
                  <TextBox x:Name="SummerAfternoonEndTextBox" Grid.Column="3" MaxLength="5"
                           AutomationProperties.Name="夏令时下午下班时间" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="冬令时" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="上午" />
                  <TextBox x:Name="WinterMorningStartTextBox" Grid.Column="1" MaxLength="5"
                           AutomationProperties.Name="冬令时上午上班时间" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="→" />
                  <TextBox x:Name="WinterMorningEndTextBox" Grid.Column="3" MaxLength="5"
                           AutomationProperties.Name="冬令时上午下班时间" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="下午" />
                  <TextBox x:Name="WinterAfternoonStartTextBox" Grid.Column="1" MaxLength="5"
                           AutomationProperties.Name="冬令时下午上班时间" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="→" />
                  <TextBox x:Name="WinterAfternoonEndTextBox" Grid.Column="3" MaxLength="5"
                           AutomationProperties.Name="冬令时下午下班时间" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Profile 切换" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                  <RadioButton x:Name="AutomaticModeRadioButton" Margin="0,0,20,0"
                               GroupName="ScheduleMode" Checked="ScheduleMode_OnChanged"
                               Content="自动切换" />
                  <RadioButton x:Name="ManualModeRadioButton" GroupName="ScheduleMode"
                               Checked="ScheduleMode_OnChanged" Content="手动切换" />
                </StackPanel>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" /><ColumnDefinition Width="110" />
                    <ColumnDefinition Width="40" /><ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="夏令时日期" />
                  <TextBox x:Name="AutomaticSummerStartTextBox" Grid.Column="1" MaxLength="5" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="至" />
                  <TextBox x:Name="AutomaticSummerEndTextBox" Grid.Column="3" MaxLength="5" />
                </Grid>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="手动 Profile" />
                  <ComboBox x:Name="ManualProfileComboBox" Grid.Column="1">
                    <ComboBoxItem Content="夏令时" /><ComboBoxItem Content="冬令时" />
                  </ComboBox>
                </Grid>
                <Button Margin="0,16,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveScheduleButton_OnClick" Content="保存作息时间" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RemindersPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="提醒设置" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}"
                       Text="提醒逻辑仍由 ReminderEngine 统一管理" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="喝水提醒" />
                <WrapPanel Margin="0,8,0,0">
                  <CheckBox x:Name="DrinkReminderEnabledCheckBox" Margin="0,0,18,0" Content="启用" />
                  <TextBlock VerticalAlignment="Center" Text="间隔" />
                  <ComboBox x:Name="DrinkIntervalComboBox" Width="76" Margin="8,0" IsEditable="True">
                    <ComboBoxItem Content="30" /><ComboBoxItem Content="45" />
                    <ComboBoxItem Content="60" /><ComboBoxItem Content="90" />
                  </ComboBox>
                  <TextBlock VerticalAlignment="Center" Text="分钟" />
                  <CheckBox x:Name="DrinkPopupCheckBox" Margin="18,0,0,0" Content="弹窗" />
                </WrapPanel>

                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />
                <TextBlock FontWeight="SemiBold" Text="站立提醒" />
                <WrapPanel Margin="0,8,0,0">
                  <CheckBox x:Name="StandReminderEnabledCheckBox" Margin="0,0,18,0" Content="启用" />
                  <TextBlock VerticalAlignment="Center" Text="连续工作" />
                  <ComboBox x:Name="StandContinuousComboBox" Width="76" Margin="8,0" IsEditable="True">
                    <ComboBoxItem Content="30" /><ComboBoxItem Content="45" />
                    <ComboBoxItem Content="50" /><ComboBoxItem Content="60" />
                  </ComboBox>
                  <TextBlock VerticalAlignment="Center" Text="分钟" />
                  <CheckBox x:Name="StandPopupCheckBox" Margin="18,0,0,0" Content="弹窗" />
                </WrapPanel>
                <TextBlock Margin="0,5,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="基于真实连续工作时间；AFK 会结束当前连续工作。" />

                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />
                <TextBlock FontWeight="SemiBold" Text="午休与下午上班" />
                <WrapPanel Margin="0,8,0,0">
                  <CheckBox x:Name="LunchSoonEnabledCheckBox" Content="午休前提醒" />
                  <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="提前" />
                  <ComboBox x:Name="LunchSoonAdvanceComboBox" Width="72" Margin="8,0">
                    <ComboBoxItem Content="5" /><ComboBoxItem Content="10" /><ComboBoxItem Content="15" />
                  </ComboBox>
                  <TextBlock VerticalAlignment="Center" Text="分钟" />
                </WrapPanel>
                <WrapPanel Margin="0,9,0,0">
                  <CheckBox x:Name="LunchStartEnabledCheckBox" Margin="0,0,18,0" Content="午休开始提醒" />
                  <CheckBox x:Name="AfternoonStartEnabledCheckBox" Content="下午上班提醒" />
                </WrapPanel>

                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />
                <TextBlock FontWeight="SemiBold" Text="下班提醒" />
                <WrapPanel Margin="0,8,0,0">
                  <CheckBox x:Name="OffWorkSpeechCheckBox" Margin="0,0,18,0" Content="下班语音" />
                  <CheckBox x:Name="OffWorkPopupCheckBox" Content="下班弹窗" />
                </WrapPanel>

                <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />
                <CheckBox x:Name="AutoOvertimePromptEnabledCheckBox"
                          Content="下班后持续工作时询问是否进入加班" />
                <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionTextStyle}"
                           Text="正常下班后持续活跃 15 分钟时询问，不会自动进入加班。" />
                <CheckBox x:Name="CleaningReminderEnabledCheckBox"
                          Content="下班前提醒打扫卫生" />
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                  <TextBlock Width="90" VerticalAlignment="Center" Text="提前提醒" />
                  <ComboBox x:Name="CleaningReminderAdvanceComboBox" Width="100" IsEditable="True">
                    <ComboBoxItem Content="10" /><ComboBoxItem Content="15" />
                    <ComboBoxItem Content="20" /><ComboBoxItem Content="30" />
                    <ComboBoxItem Content="45" /><ComboBoxItem Content="60" />
                  </ComboBox>
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="分钟" />
                </StackPanel>
                <Button Margin="0,16,0,0" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveReminderButton_OnClick" Content="保存提醒设置" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SpeechPage" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="语音与提示" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}"
                       Text="当前可用的提示通道" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <CheckBox x:Name="GlobalSpeechEnabledCheckBox" FontWeight="SemiBold"
                          Content="启用语音提醒" />
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="语音" />
                  <ComboBox x:Name="SpeechVoiceComboBox" Grid.Column="1"
                            AutomationProperties.Name="语音选择" />
                </Grid>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="语音音量" />
                  <Slider x:Name="SpeechVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                          TickFrequency="10" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding ElementName=SpeechVolumeSlider, Path=Value, StringFormat={}{0:0}%}" />
                </Grid>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Text="语速" />
                  <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Slider x:Name="SpeechRateSlider" Minimum="-1" Maximum="1"
                           TickFrequency="1" IsSnapToTickEnabled="True" />
                    <Grid Grid.Row="1" Margin="0,2,0,0">
                      <TextBlock HorizontalAlignment="Left" Style="{StaticResource CaptionTextStyle}" Text="较慢" />
                      <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="自然" />
                      <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" Text="较快" />
                    </Grid>
                  </Grid>
                </Grid>
                <TextBlock Margin="0,14,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="所有提醒共用这组本地离线语音参数；会议模式下普通提醒默认静音。" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding SpeechBackendName, StringFormat=当前后端：{0}}" />
                <WrapPanel Margin="0,14,0,0">
                  <CheckBox x:Name="DrinkSpeechCheckBox" Margin="0,0,18,8" Content="喝水语音" />
                  <CheckBox x:Name="StandSpeechCheckBox" Margin="0,0,18,8" Content="站立语音" />
                  <CheckBox x:Name="ScheduleSpeechCheckBox" Margin="0,0,18,8" Content="作息语音" />
                  <CheckBox x:Name="CleaningSpeechCheckBox" Content="打扫卫生语音" />
                </WrapPanel>
                <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                  <Button Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}"
                          Click="SaveSpeechButton_OnClick" Content="保存语音设置" />
                  <Button Style="{StaticResource ActionButtonStyle}"
                          Click="TestSpeechButton_OnClick" Content="试听声音" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AppearancePage" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="图标与界面" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}" Text="当前界面状态" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="界面风格" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="浅色 · 紧凑模式" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="实时曲线" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="已显示；窗口隐藏后停止刷新" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="动态托盘图标" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="已按状态、模式和提醒动态切换" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="DataPage" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="数据管理" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}" Text="本机 SQLite 数据" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="数据库路径" />
                <TextBox Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap"
                         Text="{Binding DatabasePath, Mode=OneWay}" />
                <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="当前大小" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding DatabaseSize}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource TitleTextStyle}" Text="关于" />
            <TextBlock Margin="0,4,0,18" Style="{StaticResource CaptionTextStyle}" Text="WorkMate" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <Image Width="80" Height="80" HorizontalAlignment="Left"
                       Source="/WorkMate;component/Assets/Icons/WorkMate_UI_IconPack/App/workmate_default.png" />
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" FontSize="16"
                           Text="你的桌面工作节律助手" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}"
                           Text="安静记录，适时提醒。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Right" MinWidth="86" Style="{StaticResource ActionButtonStyle}"
                Click="CloseButton_OnClick" Content="关闭" />
      </Grid>
    </Grid>
  </Grid>
</Window>
